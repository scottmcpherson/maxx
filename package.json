{
  "name": "maxx-workspace",
  "private": true,
  "scripts": {
    "dev": "node script/dev.mjs",
    "dev:list": "node script/dev_list.mjs",
    "dev:status": "node script/dev_status.mjs",
    "dev:renderer": "pnpm --dir apps/desktop dev:renderer",
    "dev:desktop": "pnpm --dir apps/desktop dev:desktop",
    "build": "pnpm --dir apps/desktop build",
    "build:runtime": "pnpm --dir apps/desktop build:runtime",
    "build:runtime:universal": "pnpm --dir apps/desktop build:runtime:universal",
    "build:desktop": "pnpm --dir apps/desktop build:desktop",
    "release:mac": "pnpm --dir apps/desktop release:mac",
    "desktop:verify": "pnpm --dir apps/desktop verify",
    "desktop:run": "pnpm --dir apps/desktop preview:app",
    "test:app": "pnpm --dir apps/desktop test:app",
    "test:host": "pnpm --dir apps/desktop test:host",
    "test:browser": "pnpm --dir apps/desktop test:browser",
    "test:browser:hermes": "pnpm --dir apps/desktop test:browser:hermes",
    "benchmark:terminal": "pnpm --dir apps/desktop benchmark:terminal",
    "mobile:start": "node script/mobile.mjs start",
    "mobile:ios": "node script/mobile.mjs ios",
    "mobile:identity": "node script/mobile.mjs identity",
    "mobile:typecheck": "pnpm --dir apps/mobile typecheck",
    "mobile:test": "pnpm --dir apps/mobile test",
    "electron:compile": "pnpm --dir apps/desktop electron:compile",
    "preview": "pnpm --dir apps/desktop preview",
    "test": "pnpm --dir apps/desktop test && pnpm --dir apps/mobile test && pnpm test:dev-instance",
    "test:dev-instance": "node --test script/dev_instance.node-test.mjs"
  }
}
