<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated bundle Info.plist by tauri-bundler.

  NSMicrophoneUsageDescription is required, not optional: without it macOS
  terminates the process the moment anything calls getUserMedia, instead of
  showing the permission prompt. The string is what the user reads in that
  prompt, so it names the feature rather than the API.
-->
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Maxx uses your microphone to transcribe what you say into the message box. Audio is sent to the transcription service you configure in Settings, and dictation only runs while you have it switched on.</string>
</dict>
</plist>
