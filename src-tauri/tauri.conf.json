{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maxx",
  "version": "0.1.0",
  "identifier": "com.maxx.app",
  "build": {
    "beforeDevCommand": "./script/prepare_browser_runtime.sh && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./script/prepare_browser_runtime.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Maxx",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 24 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DATA/Maxx/agent-images/**", "$DATA/Maxx/chat-images/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": ["browser-runtime"]
  },
  "plugins": {
    "//": "PLACEHOLDER updater config. The plugin refuses to load without a plugins.updater block, so this must exist even while empty. Fill in endpoints + pubkey to enable updates — see docs/native-integration.md. Never commit the matching private key.",
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
